# Example .env for the server
# Copy this file to .env and fill in real values before deploying

# MongoDB connection string (required)
# Format for Atlas: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>

# Optional: port (not used on Vercel serverless functions)
PORT=8000

# Frontend URL to allow CORS (set this in Vercel as CLIENT_URL)
CLIENT_URL=https://your-frontend-domain.com
